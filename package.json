{
  "name": "cointmu-cli",
  "version": "1.3.10",
  "codename": "Komainu",
  "description": "Primary development toolkit for the CointMU blockchain",
  "keywords": [
    "cointmu",
    "cli",
    "blockchain",
    "solidity",
    "hardhat",
    "web3"
  ],
  "homepage": "https://github.com/kakonoomoidee/CointMU-CLI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakonoomoidee/CointMU-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/kakonoomoidee/CointMU-CLI/issues"
  },
  "author": "tvrststtp",
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0"
  },
  "main": "dist/index.js",
  "bin": {
    "cmu": "dist/index.js"
  },
  "files": [
    "dist",
    "hardhat.config.js"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "preversion": "npm run build",
    "version": "node scripts/set-codename.js",
    "prepublishOnly": "npm run build",
    "prepare": "husky || true"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ethers": "6.17.0",
    "hardhat": "3.17.0",
    "inquirer": "^14.2.0",
    "solc": "0.8.37",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "hardhat": {
      "adm-zip": "^0.6.0"
    },
    "solc": {
      "tmp": "^0.2.6"
    },
    "esbuild": "^0.28.1"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
